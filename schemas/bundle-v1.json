{
  "$defs": {
    "AccountState": {
      "description": "Provider Account lifecycle; DRAFT means unmeasured/never servable.",
      "enum": [
        "draft",
        "active",
        "disabled",
        "tombstoned"
      ],
      "title": "AccountState",
      "type": "string"
    },
    "AuthorizedLeg": {
      "additionalProperties": false,
      "description": "Exact per-leg authority; parallel ID/trigger lists cannot drift apart.",
      "properties": {
        "account_id": {
          "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "AccountId",
          "type": "string"
        },
        "allowed_triggers": {
          "items": {
            "$ref": "#/$defs/RouteTrigger"
          },
          "minItems": 1,
          "title": "Allowed Triggers",
          "type": "array"
        },
        "capabilities": {
          "$ref": "#/$defs/LegCapabilities"
        },
        "generation_id": {
          "pattern": "^dg1_[0-9a-f]{64}$",
          "title": "DeploymentGenerationId",
          "type": "string"
        },
        "leg_id": {
          "pattern": "^leg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "RouteLegId",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "leg_id",
        "account_id",
        "generation_id",
        "order",
        "allowed_triggers",
        "capabilities"
      ],
      "title": "AuthorizedLeg",
      "type": "object"
    },
    "ClientCredentialVerifier": {
      "additionalProperties": false,
      "description": "One immutable canonical-key verifier generation.",
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "not_after_s": {
          "exclusiveMinimum": 0,
          "title": "Not After S",
          "type": "integer"
        },
        "not_before_s": {
          "exclusiveMinimum": 0,
          "title": "Not Before S",
          "type": "integer"
        },
        "pepper_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Pepper Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CredentialVerifierStatus"
        },
        "verifier_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verifier Hex",
          "type": "string"
        }
      },
      "required": [
        "generation",
        "verifier_hex",
        "pepper_version",
        "not_before_s",
        "not_after_s",
        "status"
      ],
      "title": "ClientCredentialVerifier",
      "type": "object"
    },
    "ClientKeyRecord": {
      "additionalProperties": false,
      "description": "One logical client key with at most two canonical/legacy generations.",
      "properties": {
        "credential_verifiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClientCredentialVerifier"
          },
          "maxItems": 2,
          "title": "Credential Verifiers",
          "type": "array"
        },
        "expires_at_s": {
          "exclusiveMinimum": 0,
          "title": "Expires At S",
          "type": "integer"
        },
        "generation_high_water": {
          "minimum": 1,
          "title": "Generation High Water",
          "type": "integer"
        },
        "issued_at_s": {
          "exclusiveMinimum": 0,
          "title": "Issued At S",
          "type": "integer"
        },
        "key_id": {
          "pattern": "^[0-9a-f]{32}$",
          "title": "Key Id",
          "type": "string"
        },
        "legacy_verifiers": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LegacyClientCredentialVerifier"
          },
          "maxItems": 2,
          "title": "Legacy Verifiers",
          "type": "array"
        },
        "policy_id": {
          "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "PolicyRevisionId",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/KeyLifecycleState"
        },
        "time_high_water_s": {
          "exclusiveMinimum": 0,
          "title": "Time High Water S",
          "type": "integer"
        }
      },
      "required": [
        "key_id",
        "policy_id",
        "state",
        "issued_at_s",
        "expires_at_s",
        "time_high_water_s",
        "generation_high_water"
      ],
      "title": "ClientKeyRecord",
      "type": "object"
    },
    "CredentialVerifierStatus": {
      "description": "Lifecycle of one immutable client credential verifier generation.",
      "enum": [
        "active",
        "retiring",
        "retired",
        "expired"
      ],
      "title": "CredentialVerifierStatus",
      "type": "string"
    },
    "EndpointKind": {
      "description": "Certified V1 inference endpoints; unsupported paths never coerce.",
      "enum": [
        "chat",
        "text",
        "embeddings",
        "rerank",
        "audio_speech",
        "audio_transcription",
        "image"
      ],
      "title": "EndpointKind",
      "type": "string"
    },
    "KeyLifecycleState": {
      "description": "Client-key lifecycle: DRAFT → ENABLED ↔ SUSPENDED → REVOKED.",
      "enum": [
        "draft",
        "enabled",
        "suspended",
        "revoked"
      ],
      "title": "KeyLifecycleState",
      "type": "string"
    },
    "KeyPolicyRevision": {
      "additionalProperties": false,
      "description": "One complete immutable policy revision bound to client keys.",
      "properties": {
        "authorized_legs": {
          "items": {
            "$ref": "#/$defs/AuthorizedLeg"
          },
          "minItems": 1,
          "title": "Authorized Legs",
          "type": "array"
        },
        "deadline_ms": {
          "maximum": 9000000,
          "minimum": 1,
          "title": "Deadline Ms",
          "type": "integer"
        },
        "max_concurrency": {
          "minimum": 1,
          "title": "Max Concurrency",
          "type": "integer"
        },
        "max_waiters": {
          "minimum": 0,
          "title": "Max Waiters",
          "type": "integer"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "policy_id": {
          "pattern": "^pol_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "PolicyRevisionId",
          "type": "string"
        },
        "queue_tier": {
          "minimum": 0,
          "title": "Queue Tier",
          "type": "integer"
        },
        "queue_weight": {
          "maximum": 64,
          "minimum": 1,
          "title": "Queue Weight",
          "type": "integer"
        },
        "route_group_ids": {
          "items": {
            "pattern": "^rg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
            "title": "RouteGroupId",
            "type": "string"
          },
          "minItems": 1,
          "title": "Route Group Ids",
          "type": "array"
        }
      },
      "required": [
        "policy_id",
        "name",
        "route_group_ids",
        "authorized_legs",
        "queue_tier",
        "queue_weight",
        "max_concurrency",
        "max_waiters",
        "deadline_ms"
      ],
      "title": "KeyPolicyRevision",
      "type": "object"
    },
    "LegCapabilities": {
      "additionalProperties": false,
      "description": "Closed serving shape copied into every immutable authorization ceiling.",
      "properties": {
        "context_tokens": {
          "exclusiveMinimum": 0,
          "title": "Context Tokens",
          "type": "integer"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/EndpointKind"
          },
          "minItems": 1,
          "title": "Endpoints",
          "type": "array"
        },
        "forced_tool": {
          "title": "Forced Tool",
          "type": "boolean"
        },
        "history_continuation": {
          "default": false,
          "title": "History Continuation",
          "type": "boolean"
        },
        "modalities": {
          "items": {
            "$ref": "#/$defs/Modality"
          },
          "minItems": 1,
          "title": "Modalities",
          "type": "array"
        },
        "reasoning": {
          "default": false,
          "title": "Reasoning",
          "type": "boolean"
        },
        "response_schema": {
          "title": "Response Schema",
          "type": "boolean"
        },
        "shadow": {
          "title": "Shadow",
          "type": "boolean"
        },
        "streaming": {
          "default": false,
          "title": "Streaming",
          "type": "boolean"
        },
        "tools": {
          "title": "Tools",
          "type": "boolean"
        }
      },
      "required": [
        "endpoints",
        "modalities",
        "context_tokens",
        "tools",
        "forced_tool",
        "response_schema",
        "shadow"
      ],
      "title": "LegCapabilities",
      "type": "object"
    },
    "LegacyClientCredentialVerifier": {
      "additionalProperties": false,
      "description": "One bounded ``sk-*`` HMAC fingerprint; plaintext is never serialized.",
      "properties": {
        "fingerprint_hex": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprint Hex",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "not_after_s": {
          "exclusiveMinimum": 0,
          "title": "Not After S",
          "type": "integer"
        },
        "not_before_s": {
          "exclusiveMinimum": 0,
          "title": "Not Before S",
          "type": "integer"
        },
        "pepper_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
          "title": "Pepper Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CredentialVerifierStatus"
        }
      },
      "required": [
        "generation",
        "fingerprint_hex",
        "pepper_version",
        "not_before_s",
        "not_after_s",
        "status"
      ],
      "title": "LegacyClientCredentialVerifier",
      "type": "object"
    },
    "Modality": {
      "description": "Request modality accepted by the V1 profiler.",
      "enum": [
        "chat",
        "text",
        "responses",
        "messages",
        "embedding",
        "rerank",
        "audio_speech",
        "audio_transcription",
        "audio_translation",
        "image"
      ],
      "title": "Modality",
      "type": "string"
    },
    "ProviderAccount": {
      "additionalProperties": false,
      "description": "One real shared upstream quota boundary (not a vendor brand).",
      "properties": {
        "account_id": {
          "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "AccountId",
          "type": "string"
        },
        "binding_ref": {
          "default": "",
          "maxLength": 256,
          "title": "Binding Ref",
          "type": "string"
        },
        "connection": {
          "default": "",
          "maxLength": 256,
          "title": "Connection",
          "type": "string"
        },
        "credential_epoch": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Epoch"
        },
        "credential_fingerprint": {
          "anyOf": [
            {
              "pattern": "^hcf1_[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Fingerprint"
        },
        "display_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "local_parallel_ceiling": {
          "maximum": 128,
          "minimum": 1,
          "title": "Local Parallel Ceiling",
          "type": "integer"
        },
        "monthly_quota_units": {
          "$ref": "#/$defs/QuotaDimension"
        },
        "monthly_reset_at_ms": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Reset At Ms"
        },
        "parallel_limit": {
          "$ref": "#/$defs/QuotaDimension"
        },
        "provider_token": {
          "default": "",
          "maxLength": 256,
          "title": "Provider Token",
          "type": "string"
        },
        "quota_units_per_attempt": {
          "minimum": 0,
          "title": "Quota Units Per Attempt",
          "type": "integer"
        },
        "rpm_limit": {
          "$ref": "#/$defs/QuotaDimension"
        },
        "rpm_window_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 3600,
          "title": "Rpm Window Seconds",
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/AccountState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tpm_limit": {
          "$ref": "#/$defs/QuotaDimension"
        },
        "tpm_window_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Tpm Window Seconds",
          "type": "integer"
        }
      },
      "required": [
        "account_id",
        "display_name",
        "parallel_limit",
        "local_parallel_ceiling",
        "rpm_limit",
        "rpm_window_seconds",
        "tpm_limit",
        "tpm_window_seconds",
        "monthly_quota_units",
        "quota_units_per_attempt"
      ],
      "title": "ProviderAccount",
      "type": "object"
    },
    "QuotaDimension": {
      "additionalProperties": false,
      "description": "One independently bounded quota dimension and its attestation state.",
      "properties": {
        "status": {
          "$ref": "#/$defs/QuotaDimensionStatus"
        },
        "value": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "status"
      ],
      "title": "QuotaDimension",
      "type": "object"
    },
    "QuotaDimensionStatus": {
      "description": "Whether one provider quota dimension is bounded, unknown, or unlimited.",
      "enum": [
        "known",
        "unknown",
        "attested_absent"
      ],
      "title": "QuotaDimensionStatus",
      "type": "string"
    },
    "RequiredFeature": {
      "description": "Closed V1 bundle feature bits.",
      "enum": [
        "ordered_capacity",
        "weighted_fair_queue",
        "expiry_deny_overlay",
        "emergency_leg_activation",
        "shadow_legs",
        "credential_generation_fence"
      ],
      "title": "RequiredFeature",
      "type": "string"
    },
    "RouteGroupRevision": {
      "additionalProperties": false,
      "description": "Immutable revision of one client-visible model and its ordered legs.",
      "properties": {
        "legs": {
          "items": {
            "$ref": "#/$defs/RouteLeg"
          },
          "minItems": 1,
          "title": "Legs",
          "type": "array"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "route_group_id": {
          "pattern": "^rg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "RouteGroupId",
          "type": "string"
        },
        "strategy": {
          "$ref": "#/$defs/RouteStrategy"
        }
      },
      "required": [
        "route_group_id",
        "name",
        "strategy",
        "legs"
      ],
      "title": "RouteGroupRevision",
      "type": "object"
    },
    "RouteLeg": {
      "additionalProperties": false,
      "description": "One ordered candidate leg inside a Route Group revision.",
      "properties": {
        "account_id": {
          "pattern": "^acc_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "AccountId",
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/LegCapabilities"
        },
        "generation_id": {
          "pattern": "^dg1_[0-9a-f]{64}$",
          "title": "DeploymentGenerationId",
          "type": "string"
        },
        "leg_id": {
          "pattern": "^leg_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
          "title": "RouteLegId",
          "type": "string"
        },
        "order": {
          "minimum": 1,
          "title": "Order",
          "type": "integer"
        },
        "triggers": {
          "items": {
            "$ref": "#/$defs/RouteTrigger"
          },
          "minItems": 1,
          "title": "Triggers",
          "type": "array"
        }
      },
      "required": [
        "leg_id",
        "order",
        "triggers",
        "account_id",
        "generation_id",
        "capabilities"
      ],
      "title": "RouteLeg",
      "type": "object"
    },
    "RouteStrategy": {
      "description": "V1 supports exactly one deterministic strategy; others fail closed.",
      "enum": [
        "ordered_capacity"
      ],
      "title": "RouteStrategy",
      "type": "string"
    },
    "RouteTrigger": {
      "description": "Typed causes that may activate a non-primary leg (design: V1 triggers).",
      "enum": [
        "primary",
        "capacity_spill",
        "failure_fallback",
        "quota_fallback",
        "manual_emergency",
        "shadow"
      ],
      "title": "RouteTrigger",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The complete immutable enforcement snapshot applied by one generation.",
  "properties": {
    "accounts": {
      "items": {
        "$ref": "#/$defs/ProviderAccount"
      },
      "minItems": 1,
      "title": "Accounts",
      "type": "array"
    },
    "backend_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Backend Manifest Hash",
      "type": "string"
    },
    "generation": {
      "minimum": 1,
      "title": "Generation",
      "type": "integer"
    },
    "keys": {
      "items": {
        "$ref": "#/$defs/ClientKeyRecord"
      },
      "minItems": 1,
      "title": "Keys",
      "type": "array"
    },
    "min_reader": {
      "title": "Min Reader",
      "type": "string"
    },
    "policies": {
      "items": {
        "$ref": "#/$defs/KeyPolicyRevision"
      },
      "minItems": 1,
      "title": "Policies",
      "type": "array"
    },
    "required_features": {
      "items": {
        "$ref": "#/$defs/RequiredFeature"
      },
      "title": "Required Features",
      "type": "array",
      "uniqueItems": true
    },
    "route_groups": {
      "items": {
        "$ref": "#/$defs/RouteGroupRevision"
      },
      "minItems": 1,
      "title": "Route Groups",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "generation",
    "min_reader",
    "required_features",
    "keys",
    "policies",
    "accounts",
    "route_groups",
    "backend_manifest_hash"
  ],
  "title": "PolicyBundleV1",
  "type": "object"
}
